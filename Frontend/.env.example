# ========================================================
# Frontend & Review Flow Environment Variables (.env.local)
# ========================================================

# 1. Sanity Public Read Configuration (Client-side)
VITE_SANITY_PROJECT_ID=n2y8hmqi
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-05-01

# 2. Sanity Serverless API Configuration (Server-side / Vercel Functions)
SANITY_PROJECT_ID=n2y8hmqi
SANITY_DATASET=production

# 3. Sanity API Write Token with "Editor" Role
# How to generate:
#   1. Go to https://manage.sanity.io -> Select project (n2y8hmqi)
#   2. Navigate to "API" -> "Tokens" -> "Add API token"
#   3. Name: "Portfolio Review Submitter", Role: "Editor"
#   4. Paste token below (Keep secret! Never commit to Git)
SANITY_WRITE_TOKEN=

# 4. Allowed Origins for Review Submissions (CORS & Anti-abuse)
# Comma-separated list of exact allowed origins (scheme + host).
# Include your custom domain, vercel.app domain, and localhost for local testing.
# In production, requests without a valid matching origin/referer are rejected.
ALLOWED_ORIGIN=https://vinothkumarm27.vercel.app,http://localhost:5173,http://localhost:3000

# 5. IP Hashing Secret (HMAC-SHA256 for Rate Limiting)
# Secret key used to hash visitor IP addresses before saving or querying rate limits.
# Raw IP addresses are NEVER stored in Sanity.
REVIEW_HASH_SECRET=your_random_32_character_secret_here

# 6. Cloudflare Turnstile Bot Protection (Free)
# How to get Turnstile keys:
#   1. Sign in to Cloudflare Dashboard -> "Turnstile"
#   2. Click "Add Site" -> Name: "Portfolio Reviews", Domain: "vinothkumarm27.vercel.app"
#   3. Widget Type: Managed (recommended) or Non-interactive
#   4. Copy Site Key and Secret Key below.
#
# Note: For local development/testing, Cloudflare provides official dummy keys:
#   Site Key (Always passes):  1x00000000000000000000AA
#   Secret Key (Always passes): 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
